# Copy to backend/.env and fill in the providers you're actually using.
# See backend/src/config/settings.py for the full list of fields and defaults.
# NOTE: variables exported in your shell (e.g. AWS_REGION) override this file.

HOST=127.0.0.1
PORT=8080

# Provider selection — one of: sarvam, cartesia, deepgram, elevenlabs
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs

# Voice provider API keys (only the ones matching STT_PROVIDER/TTS_PROVIDER are required)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SARVAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
DEEPGRAM_API_KEY=

# LLM (AWS Bedrock)
MAIN_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

# Optional — only used if you switch the LLM to Gemini in backend/src/pipecat/pipeline.py
GEMINI_API_KEY=

# Telephony (Vobiz) — only needed for phone calls (/vobiz/calls, /answer, /ws)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
VOBIZ_ENCODING=audio/x-mulaw
VOBIZ_SAMPLE_RATE=8000
# public base URL of this backend (e.g. your ngrok URL); WEBHOOK_URL is accepted too
WEBHOOK_ENDPOINT=

# Database (Postgres — call metadata + transcripts, see backend/src/db/)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_accelerator
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Knowledge base (RAG) — pgvector (default) or aws_kb (Amazon Bedrock Knowledge Base)
KB_PROVIDER=pgvector
KB_TOP_K=4
# pgvector only — must match what was used at ingestion time
KB_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
KB_TABLE_NAME=kb_chunks
# aws_kb only — see backend/src/ai/tools/aws_kb.py. Data source IDs are optional.
AWS_KB_ID=
AWS_KB_SEARCH_TYPE=
AWS_KB_DATA_SOURCE_IDS=
